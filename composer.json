{
    "name": "sushi-market/job-context-logger",
    "description": "Adds queue job details to Laravel logs.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/log": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "SushiMarket\\JobContextLogger\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SushiMarket\\JobContextLogger\\JobContextLoggerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
